# Without LLM_BASE_URL: provider:model, e.g. anthropic:claude-opus-5-5
# With LLM_BASE_URL: the plain gateway slug, e.g. minimax/minimax-m3.1-flash:free
LLM_MODEL=minimax/minimax-m3.1-flash:free

# API key for the provider or gateway
LLM_TOKEN=your-api-key

# Optional OpenAI-compatible endpoint, such as OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
